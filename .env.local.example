# Backend API base URL (no trailing slash)
API_URL=http://localhost:5000

# Public API URL — used by the browser to call the backend directly (if needed)
NEXT_PUBLIC_API_URL=http://localhost:5000

# iron-session cookie encryption secret — must be at least 32 characters
SESSION_SECRET=change-me-to-a-long-random-string-in-production-at-least-32-chars
