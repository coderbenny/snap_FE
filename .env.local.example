# Backend API base URL (no trailing slash)
# Local:      http://localhost:5559
# Production: https://api.snapit.ink/snap
API_URL=http://localhost:5559

# iron-session cookie encryption secret — must be at least 32 characters
SESSION_SECRET=change-me-to-a-long-random-string-in-production-at-least-32-chars

# Public site URL — used for sitemap, OG images, canonical links
NEXT_PUBLIC_SITE_URL=https://snapit.ink

# Paystack public key (safe to expose — used by InlineJS in the browser)
# Get from Paystack Dashboard > Settings > API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
